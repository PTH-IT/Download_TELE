# Telegram app credentials — BẮT BUỘC.
# Tạo tại https://my.telegram.org/apps
API_ID=
API_HASH=

# Cổng publish ra host — đổi khi bị trùng với dịch vụ khác đang chạy
API_PORT=8000
# Đặt khi API nằm ở host khác, ví dụ http://192.168.1.10:8000
API_BASE=
WEB_PORT=3000
PG_PORT=5432
REDIS_PORT=6379

# Số worker khởi động cùng `docker compose up -d`
WORKER_REPLICAS=1

# Concurrency mỗi worker
MAX_DL=2
MAX_UP=4
